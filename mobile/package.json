{
  "name": "repsense-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "detox test -c android.debug",
    "test:e2e:ios": "detox test -c ios.debug",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace RepSense.xcworkspace -scheme RepSense -configuration Release -destination generic/platform=iOS -archivePath build/RepSense.xcarchive archive"
  },
  "detox": {
    "testRunner": "jest",
    "testRunnerArgs": [
      "--verbose"
    ],
    "specReporter": "detox/runners/jest/specReporter",
    "verbose": true,
    "timeout": 120000,
    "apps": {
      "ios.debug": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/RepSense.app"
      },
      "android.debug": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk"
      },
      "android.release": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/release/app-release.apk"
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 15"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "avdName": "pixel_7_pro"
      }
    },
    "configurations": {
      "ios.debug": {
        "device": "simulator",
        "app": "ios.debug"
      },
      "android.debug": {
        "device": "emulator",
        "app": "android.debug"
      },
      "android.release": {
        "device": "emulator",
        "app": "android.release"
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@react-navigation/stack": "^7.11.2",
    "axios": "^1.6.2",
    "expo": "^57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-notifications": "~57.0.20",
    "expo-system-ui": "~57.0.4",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/runtime": "^7.23.6",
    "@react-native/eslint-config": "^0.73.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^18.0.7",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.12",
    "detox": "^20.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
